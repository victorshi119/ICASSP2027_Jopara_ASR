diff --git a/src/omnilingual_asr/models/wav2vec2_llama/hdmole.py b/src/omnilingual_asr/models/wav2vec2_llama/hdmole.py
new file mode 100644
index 0000000..be4aeee
--- /dev/null
+++ b/src/omnilingual_asr/models/wav2vec2_llama/hdmole.py
@@ -0,0 +1,171 @@
+from __future__ import annotations
+
+from dataclasses import dataclass, field
+from typing import Iterable
+
+import torch
+import torch.nn as nn
+
+
+@dataclass(kw_only=True)
+class HdmoleConfig:
+    enabled: bool = False
+    expert_names: list[str] = field(
+        default_factory=lambda: ["spanish_only", "guarani_only", "mixed"]
+    )
+    active_expert: str = ""
+    init_experts_from: str = ""
+    lora_rank: int = 8
+    lora_alpha: float = 16.0
+    use_adapters: bool = True
+    use_router: bool = False
+    use_global_router: bool = True
+    router_dropout_p: float = 0.0
+    router_threshold_init: float = 0.2
+    ger_enabled: bool = False
+    # If set, global router uses this column for expert key (e.g. "extra_3");
+    # otherwise uses language_column_name. Lets manifest use lang=spa_Latn/grn_Latn
+    # for LID and a separate column for expert routing.
+    router_column_name: str = ""
+
+
+class LoRAAdapter(nn.Module):
+    def __init__(self, model_dim: int, rank: int, alpha: float) -> None:
+        super().__init__()
+        self.lora_down = nn.Linear(model_dim, rank, bias=False)
+        self.lora_up = nn.Linear(rank, model_dim, bias=False)
+        self.scaling = alpha / float(rank)
+
+    def forward(self, x: torch.Tensor) -> torch.Tensor:
+        return self.lora_up(self.lora_down(x)) * self.scaling
+
+
+class HdmoleModule(nn.Module):
+    def __init__(
+        self,
+        model_dim: int,
+        *,
+        config: HdmoleConfig,
+        language_column_name: str = "lang",
+    ) -> None:
+        super().__init__()
+        self.model_dim = model_dim
+        self.config = config
+        self.language_column_name = language_column_name
+        self._router_column = config.router_column_name or language_column_name
+
+        use_adapters_or_router = config.use_adapters or config.use_router
+        self.lora_adapters = nn.ModuleDict()
+        if use_adapters_or_router:
+            for name in config.expert_names:
+                self._ensure_adapter(name)
+            if config.active_expert:
+                self._ensure_adapter(config.active_expert)
+            if config.init_experts_from and config.init_experts_from not in self.lora_adapters:
+                self._ensure_adapter(config.init_experts_from)
+            self.router = nn.Linear(model_dim, len(self.lora_adapters), bias=True)
+            self.router_dropout = nn.Dropout(p=config.router_dropout_p)
+            self.router_thresholds = nn.Parameter(
+                torch.full((len(self.lora_adapters),), config.router_threshold_init)
+            )
+        else:
+            self.router = None
+            self.router_dropout = None
+            self.router_thresholds = None
+
+        self.ger_adapter = (
+            LoRAAdapter(model_dim, config.lora_rank, config.lora_alpha)
+            if config.ger_enabled
+            else None
+        )
+
+        self._experts_initialized = False
+
+    def _ensure_adapter(self, name: str) -> None:
+        if name not in self.lora_adapters:
+            self.lora_adapters[name] = LoRAAdapter(
+                self.model_dim, self.config.lora_rank, self.config.lora_alpha
+            )
+
+    def _maybe_init_experts(self) -> None:
+        if self._experts_initialized or not self.config.init_experts_from:
+            return
+        src = self.config.init_experts_from
+        if src not in self.lora_adapters:
+            return
+        for name, adapter in self.lora_adapters.items():
+            if name == src:
+                continue
+            adapter.load_state_dict(self.lora_adapters[src].state_dict())
+        self._experts_initialized = True
+
+    def _global_router_weights(
+        self, batch, device: torch.device, num_experts: int
+    ) -> torch.Tensor:
+        if not self.config.use_global_router:
+            return torch.full((batch.source_seqs.size(0), num_experts), 1.0 / num_experts).to(
+                device
+            )
+        if not isinstance(batch.example, dict):
+            return torch.full((batch.source_seqs.size(0), num_experts), 1.0 / num_experts).to(
+                device
+            )
+        langs = batch.example.get(self._router_column)
+        if not langs:
+            return torch.full((batch.source_seqs.size(0), num_experts), 1.0 / num_experts).to(
+                device
+            )
+        name_to_idx = {name: idx for idx, name in enumerate(self.lora_adapters.keys())}
+        weights = torch.zeros((len(langs), num_experts), device=device)
+        for i, lang in enumerate(langs):
+            key = str(lang)
+            if key in name_to_idx:
+                weights[i, name_to_idx[key]] = 1.0
+            else:
+                weights[i] = 1.0 / num_experts
+        return weights
+
+    def _collect_expert_deltas(
+        self, dec_out: torch.Tensor, names: Iterable[str]
+    ) -> list[torch.Tensor]:
+        return [self.lora_adapters[name](dec_out) for name in names]
+
+    def forward(self, dec_out: torch.Tensor, batch) -> torch.Tensor:
+        if not self.config.use_adapters:
+            return dec_out
+
+        self._maybe_init_experts()
+
+        if self.config.active_expert:
+            delta = self.lora_adapters[self.config.active_expert](dec_out)
+            if self.ger_adapter is not None:
+                delta = delta + self.ger_adapter(dec_out)
+            return dec_out + delta
+
+        if not self.config.use_router or len(self.lora_adapters) == 0:
+            return dec_out
+
+        device = dec_out.device
+        B, T, _ = dec_out.shape
+        num_experts = len(self.lora_adapters)
+        expert_names = list(self.lora_adapters.keys())
+
+        router_logits = self.router_dropout(self.router(dec_out))
+        local_weights = torch.softmax(router_logits, dim=-1)
+        global_weights = self._global_router_weights(batch, device, num_experts)
+        weights = local_weights * global_weights.view(B, 1, num_experts)
+
+        thresholds = torch.sigmoid(self.router_thresholds).view(1, 1, num_experts)
+        mask = weights >= thresholds
+        weights = weights * mask
+        weight_sums = weights.sum(dim=-1, keepdim=True).clamp_min(1e-6)
+        weights = weights / weight_sums
+
+        deltas = self._collect_expert_deltas(dec_out, expert_names)
+        stacked = torch.stack(deltas, dim=-1)
+        weighted_delta = (stacked * weights.unsqueeze(-2)).sum(dim=-1)
+
+        if self.ger_adapter is not None:
+            weighted_delta = weighted_delta + self.ger_adapter(dec_out)
+
+        return dec_out + weighted_delta
